# Copier ce fichier en .env (non versionné) et adapter les valeurs.

# Connexion à la base SQL Server ou Azure SQL Database
BASE_SERVEUR=localhost
BASE_NOM=frigeo
BASE_PILOTE=ODBC Driver 18 for SQL Server

# yes uniquement pour une instance locale de développement (certificat auto-signé),
# no sur Azure SQL Database
BASE_CONFIANCE_CERTIFICAT=yes
